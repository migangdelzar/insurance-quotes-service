{
  "title": "Insurance Quotes",
  "uid": "insurance-quotes",
  "schemaVersion": 39,
  "refresh": "10s",
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Quotes created /min", "gridPos": {"x": 0, "y": 0, "w": 8, "h": 8}, "targets": [{"expr": "rate(quotes_created_total[5m]) * 60"}]},
    {"id": 2, "type": "timeseries", "title": "Submissions by outcome /min", "gridPos": {"x": 8, "y": 0, "w": 8, "h": 8}, "targets": [{"expr": "rate(quotes_submissions_total[5m]) * 60", "legendFormat": "{{outcome}}"}]},
    {"id": 3, "type": "timeseries", "title": "Insurer call p95 (s)", "gridPos": {"x": 16, "y": 0, "w": 8, "h": 8}, "targets": [{"expr": "histogram_quantile(0.95, rate(insurer_call_seconds_bucket[5m]))"}]},
    {"id": 4, "type": "timeseries", "title": "HTTP p95 latency (s)", "gridPos": {"x": 0, "y": 8, "w": 8, "h": 8}, "targets": [{"expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket[5m]))"}]},
    {"id": 5, "type": "stat", "title": "Quotes expired (total)", "gridPos": {"x": 8, "y": 8, "w": 8, "h": 8}, "targets": [{"expr": "quotes_expired_total"}]},
    {"id": 6, "type": "stat", "title": "Hikari active connections", "gridPos": {"x": 16, "y": 8, "w": 8, "h": 8}, "targets": [{"expr": "hikaricp_connections_active"}]}
  ]
}
