@startuml Use Cases Overview
left to right direction

actor "Visitor" as visitor
actor "Registered User" as user
actor "Administrator" as admin
actor "Scheduler" as scheduler
actor "Insurer" as insurer

rectangle "Insurance Quotes" {
    usecase "UC-001\nAuthenticate" as UC001
    usecase "UC-002\nEnroll a Passkey" as UC002
    usecase "UC-003\nStart a New Quote" as UC003
    usecase "UC-004\nSelect Coverage and Calculate Premium" as UC004
    usecase "UC-005\nSubmit Quote to Insurer" as UC005
    usecase "UC-006\nReview Quote History and Analytics" as UC006
    usecase "UC-007\nExpire Stale Draft Quotes" as UC007
}

visitor --> UC001
user --> UC001
user --> UC002
user --> UC003
user --> UC004
user --> UC005
user --> UC006
admin --> UC006
scheduler --> UC007
insurer --> UC005
UC004 ..> UC003 : <<extend>>
UC005 ..> UC004 : <<extend>>

@enduml
